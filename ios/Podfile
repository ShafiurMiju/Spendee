# Required for @react-native-firebase to use Firebase as static frameworks
$RNFirebaseAsStaticFramework = true

# Pin Firebase to 10.x to avoid Swift-only APIs in Firebase 11.x
$FirebaseSDKVersion = '10.29.0'

# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

target 'Spendee' do
  config = use_native_modules!

  # Modular headers needed for Firebase Swift pods as static libraries
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseFirestoreInternal', :modular_headers => true
  pod 'FirebaseAuthInterop', :modular_headers => true
  pod 'FirebaseAppCheckInterop', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Fix: Remove -weak_framework FirebaseFirestoreInternal from linker flags
    # With Firebase 10.x as static libraries + modular_headers, CocoaPods incorrectly
    # generates a framework link for FirebaseFirestoreInternal (it's a static lib, not a framework)
    Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*.xcconfig')).each do |xcconfig_path|
      xcconfig = File.read(xcconfig_path)
      if xcconfig.include?('-weak_framework "FirebaseFirestoreInternal"')
        xcconfig = xcconfig.gsub('-weak_framework "FirebaseFirestoreInternal"', '')
        File.write(xcconfig_path, xcconfig)
      end
    end

    installer.pods_project.targets.each do |target|
      if target.name == 'gRPC-Core' || target.name == 'gRPC-C++'
        target.build_configurations.each do |config|
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
          cflags = config.build_settings['OTHER_CPLUSPLUSFLAGS'] || '$(inherited)'
          unless cflags.include?('-Wno-missing-template-arg-list-after-template-kw')
            config.build_settings['OTHER_CPLUSPLUSFLAGS'] = "#{cflags} -Wno-missing-template-arg-list-after-template-kw"
          end
        end
      end
      # Fix BoringSSL-GRPC: remove -GCC_WARN_INHIBIT_ALL_WARNINGS from per-file compiler flags
      # It's incorrectly used as a compiler flag (should be a build setting) and newer clang
      # rejects the unrecognized -G option
      if target.name == 'BoringSSL-GRPC'
        target.source_build_phase.files.each do |file|
          if file.settings && file.settings['COMPILER_FLAGS']
            flags = file.settings['COMPILER_FLAGS']
            if flags.include?('-GCC_WARN_INHIBIT_ALL_WARNINGS')
              file.settings['COMPILER_FLAGS'] = flags.gsub('-GCC_WARN_INHIBIT_ALL_WARNINGS', '')
            end
          end
        end
      end
    end
  end
end
